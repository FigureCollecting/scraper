{
  "name": "scraper",
  "version": "2.3.0",
  "description": "Generic web page scraping service with browser automation",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:contract && tsc",
    "build:contract": "tsc -p packages/plugin-contract",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "echo 'No linter configured'",
    "typecheck": "npm run build:contract && tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest --config jest.config.cjs --testPathIgnorePatterns='inter-service'",
    "test:unit": "jest --config jest.config.cjs src/__tests__/unit",
    "test:integration": "jest --config jest.config.cjs src/__tests__/integration --testPathIgnorePatterns='inter-service'",
    "test:e2e": "jest --config jest.config.cjs src/__tests__/integration/inter-service",
    "test:all": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage --testPathIgnorePatterns='inter-service'",
    "test:ci": "jest --config jest.config.cjs --ci --coverage --testPathIgnorePatterns='inter-service'",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@figurecollecting/fc-shared": "^1.6.0",
    "@figurecollecting/ingest-contract": "^0.2.1",
    "@figurecollecting/scraper-plugin-contract": "file:packages/plugin-contract",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "impit": "0.14.4",
    "minio": "^8.0.7",
    "patch-package": "^8.0.1",
    "puppeteer": "^25.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tough-cookie": "6.0.2"
  },
  "overrides": {
    "qs": "^6.14.1",
    "rimraf": "^6.1.2",
    "basic-ftp": "^5.3.1",
    "undici": "^7.29.0",
    "protobufjs": "^7.6.4",
    "@grpc/grpc-js": "^1.14.4",
    "path-to-regexp": "^8.4.0",
    "typescript": {
      "glob": "^10.5.0"
    },
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "js-yaml@3": "3.15.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "mongodb": "^7.6.0",
    "msw": "^2.15.0",
    "supertest": "^7.1.4",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
