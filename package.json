{
  "name": "scraper",
  "version": "2.2.0",
  "description": "Generic web page scraping service with browser automation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "echo 'No linter configured'",
    "test": "jest --config jest.config.js --testPathIgnorePatterns='inter-service'",
    "test:unit": "jest --config jest.config.js src/__tests__/unit",
    "test:integration": "jest --config jest.config.js src/__tests__/integration --testPathIgnorePatterns='inter-service'",
    "test:e2e": "jest --config jest.config.js src/__tests__/integration/inter-service",
    "test:all": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='inter-service'",
    "test:ci": "jest --ci --coverage --testPathIgnorePatterns='inter-service'"
  },
  "dependencies": {
    "@figurecollecting/fc-shared": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.0",
    "puppeteer": "^24.37.5",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "overrides": {
    "qs": "^6.14.1",
    "rimraf": "^6.1.2",
    "basic-ftp": "^5.3.1",
    "undici": "^7.24.0",
    "protobufjs": "^7.6.4",
    "@grpc/grpc-js": "^1.14.4",
    "path-to-regexp": "^8.4.0",
    "typescript": {
      "glob": "^10.5.0"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "mongodb": "^7.1.0",
    "msw": "^2.14.6",
    "supertest": "^7.1.4",
    "testcontainers": "^11.7.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
