{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": false,
    "noImplicitAny": false,
    // Kept ON deliberately. The other strict flags are relaxed so old tests can pass loose
    // fakes, but without strictNullChecks TypeScript stops narrowing a discriminated union
    // by its `ok` flag, so `if (!r.ok)` leaves `r` as the whole union and every field of the
    // failure arm reads as an error - in the tests AND in the source files they import.
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "rootDir": ".",
    "paths": {
      "@figurecollecting/scraper-plugin-contract": ["./packages/plugin-contract/src/index.ts"]
    }
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/__mocks__/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/inter-service/**"
  ]
}
